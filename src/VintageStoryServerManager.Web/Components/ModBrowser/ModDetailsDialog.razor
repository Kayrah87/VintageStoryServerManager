@using Microsoft.Extensions.Options
@using VintageStoryServerManager.Core.Configuration
@using VintageStoryServerManager.Core.ModDb

@inject IModDbClient ModDb
@inject IOptions<ModDbOptions> ModDbOptions

<MudDialog>
    <DialogContent>
        @if (mod is null)
        {
            @if (error is null)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
            else
            {
                <MudAlert Severity="Severity.Error">@error</MudAlert>
            }
        }
        else
        {
            <div class="d-flex gap-4 flex-wrap mb-3">
                @if (mod.Logo is { } logo)
                {
                    <img src="@logo" alt="" class="mod-detail-logo" referrerpolicy="no-referrer" />
                }
                <div class="flex-grow-1" style="min-width:14rem">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        by @(mod.Author ?? "unknown") · @(mod.Side ?? "both") side
                    </MudText>
                    @if (!string.IsNullOrWhiteSpace(Summary))
                    {
                        <MudText Class="mt-2">@Summary</MudText>
                    }
                    <div class="d-flex flex-wrap gap-3 mt-2">
                        <MudText Typo="Typo.body2"><strong>@mod.Downloads.ToString("N0")</strong> downloads</MudText>
                        <MudText Typo="Typo.body2"><strong>@mod.Follows.ToString("N0")</strong> follows</MudText>
                        <MudText Typo="Typo.body2">Updated @ModDatabaseBrowser.Ago(mod.LastReleased)</MudText>
                    </div>
                    <div class="d-flex flex-wrap gap-1 mt-2">
                        @foreach (var tag in mod.Tags)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag</MudChip>
                        }
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <MudButton Size="Size.Small" Variant="Variant.Text" Href="@mod.PageUrl(ModDbOptions.Value.BaseUrl)" Target="_blank"
                                   StartIcon="@Icons.Material.Filled.OpenInNew">Mod page</MudButton>
                        @foreach (var (label, url) in Links(mod.Links))
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Href="@url" Target="_blank" Rel="noopener noreferrer">@label</MudButton>
                        }
                    </div>
                </div>
            </div>

            @if (mod.Screenshots.Count > 0)
            {
                <MudCarousel TData="ModDbScreenshot" ItemsSource="mod.Screenshots" Class="mod-carousel mb-4" ShowArrows="@(mod.Screenshots.Count > 1)"
                             ShowBullets="@(mod.Screenshots.Count > 1)" AutoCycle="false">
                    <ItemTemplate>
                        <a href="@context.Url" target="_blank" rel="noopener noreferrer" class="mod-carousel-slide">
                            <img src="@context.Url" alt="Screenshot" loading="lazy" referrerpolicy="no-referrer" />
                        </a>
                    </ItemTemplate>
                </MudCarousel>
            }

            <MudText Typo="Typo.h6" Class="mb-1">Releases</MudText>
            @if (compatible is { } pick)
            {
                <MudAlert Severity="@(pick.ExactGameVersion ? Severity.Success : Severity.Warning)" Dense="true" Class="mb-2">
                    Installing picks @pick.Release.ModVersion@(pick.ExactGameVersion ? $", made for {GameVersion}." : $": not tagged for {GameVersion}, but for the same minor version.")
                </MudAlert>
            }
            else if (GameVersion is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">No release supports game version @GameVersion.</MudAlert>
            }
            <MudSimpleTable Dense="true" Elevation="0" Style="max-height:16rem; overflow-y:auto">
                <thead><tr><th>Version</th><th>Game versions</th><th>Released</th></tr></thead>
                <tbody>
                    @foreach (var release in mod.Releases.Take(15))
                    {
                        <tr>
                            <td>
                                @release.ModVersion
                                @if (release.ReleaseId == compatible?.Release.ReleaseId)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="ml-1">Picked</MudChip>
                                }
                            </td>
                            <td>@GameVersions(release)</td>
                            <td>@release.Created?.Split(' ')[0]</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Close</MudButton>
        @if (Installed)
        {
            <MudChip T="string" Color="Color.Success" Class="mr-2">Installed</MudChip>
        }
        else if (CanInstall)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="mod is null || compatible is null"
                       OnClick="() => MudDialog.Close(DialogResult.Ok(ModKey))">Install</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string ModKey { get; set; } = "";

    [Parameter]
    public string? Summary { get; set; }

    [Parameter]
    public string? GameVersion { get; set; }

    [Parameter]
    public bool Installed { get; set; }

    [Parameter]
    public bool CanInstall { get; set; }

    private ModDbMod? mod;
    private CompatibleRelease? compatible;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            mod = await ModDb.GetModAsync(ModKey);
            if (mod is null)
            {
                error = "This mod wasn't found on the mod database.";
                return;
            }

            compatible = ReleaseSelector.PickCompatible(mod.Releases, GameVersion);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private static IEnumerable<(string Label, string Url)> Links(ModDbLinks links)
    {
        if (links.Homepage is { } homepage) yield return ("Homepage", homepage);
        if (links.Source is { } source) yield return ("Source", source);
        if (links.Wiki is { } wiki) yield return ("Wiki", wiki);
        if (links.IssueTracker is { } issues) yield return ("Issues", issues);
        if (links.Trailer is { } trailer) yield return ("Trailer", trailer);
    }

    private static string GameVersions(ModDbRelease release) => release.GameVersions.Count switch
    {
        0 => "–",
        1 => release.GameVersions[0],
        _ => $"{release.GameVersions[0]} – {release.GameVersions[^1]}",
    };
}

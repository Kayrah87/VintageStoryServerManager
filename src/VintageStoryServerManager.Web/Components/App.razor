<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    @if (PageRenderMode is null)
    {
        @* Account pages are static (server-rendered forms) and use Bootstrap. *@
        <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    }
    else
    {
        <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    }
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["VintageStoryServerManager.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    @if (PageRenderMode is null)
    {
        <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    }
    else
    {
        <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    }
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Everything is interactive except pages marked [ExcludeFromInteractiveRouting] (the account pages).
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}

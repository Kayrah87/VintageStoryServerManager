@page "/config"
@attribute [Authorize(Roles = Roles.Admin)]
@implements IDisposable

@using VintageStoryServerManager.Infrastructure.Config

@inject ServerConfigService Config
@inject IGameServer Server
@inject ISnackbar Snackbar

<PageTitle>Server settings</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Server settings</MudText>

<MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4" @bind-ActivePanelIndex="activeTab">
    <MudTabPanel Text="Settings">
        <SettingsPanel />
    </MudTabPanel>
    <MudTabPanel Text="Raw serverconfig.json">
        <div class="d-flex align-center mb-2 gap-2 flex-wrap">
            <MudText Color="Color.Secondary">
                Every setting in <code>serverconfig.json</code>, including roles and world-creation defaults. The previous version is backed up when you save.
            </MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh" Disabled="busy" OnClick="LoadAsync">Reload</MudButton>
            <MudButton Variant="Variant.Outlined" Disabled="busy" OnClick="Validate">Check</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       Disabled="busy || !canSave || !dirty" OnClick="SaveAsync">Save</MudButton>
        </div>

        @if (!canSave)
        {
            <MudAlert Severity="Severity.Info" Class="mb-3">
                Stop the server to edit the raw file. The server rewrites it when it shuts down, which would undo your changes.
                The Settings tab can save and restart for you.
            </MudAlert>
        }

        @if (validationError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@validationError</MudAlert>
        }

        @if (text is null)
        {
            <MudAlert Severity="Severity.Info">There's no serverconfig.json yet. The server creates one the first time it starts.</MudAlert>
        }
        else
        {
            <MudTextField T="string" Value="text" ValueChanged="OnChanged" Lines="32" Variant="Variant.Outlined" Class="code-editor"
                          ReadOnly="!canSave" Immediate="false" spellcheck="false" aria-label="serverconfig.json" />
        }
    </MudTabPanel>
</MudTabs>

@code {
    private int activeTab;
    private string? text;
    private string? validationError;
    private bool dirty;
    private bool busy;
    private ServerSnapshot snapshot = default!;

    private bool canSave => !snapshot.IsRunning && snapshot.Status != ServerStatus.Stopping;

    protected override async Task OnInitializedAsync()
    {
        snapshot = Server.Snapshot;
        Server.StatusChanged += OnStatusChanged;
        await LoadAsync();
    }

    private void OnStatusChanged(ServerSnapshot updated)
    {
        var stoppedNow = !updated.IsRunning && updated.Status != ServerStatus.Stopping && !canSave;
        snapshot = updated;
        _ = InvokeAsync(async () =>
        {
            // Pick up what the server wrote on shutdown, unless there are unsaved edits.
            if (stoppedNow && !dirty)
            {
                await LoadAsync();
            }

            StateHasChanged();
        });
    }

    private async Task LoadAsync()
    {
        text = await Config.ReadAsync();
        dirty = false;
        validationError = null;
    }

    private void OnChanged(string value)
    {
        text = value;
        dirty = true;
        validationError = null;
    }

    private void Validate()
    {
        validationError = text is null ? null : ServerConfigService.Validate(text);
        if (validationError is null)
        {
            Snackbar.Add("The config is valid JSON.", Severity.Success);
        }
    }

    private async Task SaveAsync()
    {
        if (text is null)
        {
            return;
        }

        validationError = ServerConfigService.Validate(text);
        if (validationError is not null)
        {
            return;
        }

        busy = true;
        try
        {
            await Config.SaveAsync(text);
            dirty = false;
            Snackbar.Add("Saved. The changes apply when the server next starts.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            busy = false;
        }
    }

    public void Dispose() => Server.StatusChanged -= OnStatusChanged;
}

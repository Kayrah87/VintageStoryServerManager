@page "/admin/users"
@attribute [Authorize(Roles = Roles.Admin)]
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using VintageStoryServerManager.Web.Data

@inject UserAdministrationService UserAdmin

<PageTitle>Users</PageTitle>

<h1>Users</h1>

@if (message is not null)
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-success")" role="alert">@message</div>
}

<section class="mb-5">
    <h2 class="h4">Add user</h2>
    <EditForm Model="newUser" OnValidSubmit="CreateUserAsync" FormName="create-user">
        <DataAnnotationsValidator />
        <div class="row g-2 align-items-end">
            <div class="col-sm-4">
                <label for="new-username" class="form-label">Username</label>
                <InputText id="new-username" @bind-Value="newUser.UserName" class="form-control" autocomplete="off" />
                <ValidationMessage For="() => newUser.UserName" class="text-danger" />
            </div>
            <div class="col-sm-4">
                <label for="new-password" class="form-label">Password</label>
                <InputText id="new-password" type="password" @bind-Value="newUser.Password" class="form-control" autocomplete="new-password" />
                <ValidationMessage For="() => newUser.Password" class="text-danger" />
            </div>
            <div class="col-sm-2">
                <div class="form-check mb-2">
                    <InputCheckbox id="new-admin" @bind-Value="newUser.IsAdmin" class="form-check-input" />
                    <label for="new-admin" class="form-check-label">Admin</label>
                </div>
            </div>
            <div class="col-sm-2">
                <button type="submit" class="btn btn-primary w-100" disabled="@busy">Add</button>
            </div>
        </div>
    </EditForm>
</section>

<section>
    <h2 class="h4">Accounts</h2>
    @if (users is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    var isSelf = user.Id == currentUserId;
                    <tr @key="user.Id">
                        <td>@user.UserName @(isSelf ? "(you)" : "")</td>
                        <td>@(user.IsAdmin ? "Admin" : "User")</td>
                        <td>@(user.IsLockedOut ? "Locked out" : "Active")</td>
                        <td class="text-end">
                            @if (resetUserId == user.Id)
                            {
                                <div class="d-inline-flex gap-2">
                                    <input type="password" class="form-control form-control-sm" placeholder="New password"
                                           autocomplete="new-password" @bind="resetPassword" />
                                    <button class="btn btn-sm btn-primary" disabled="@busy" @onclick="() => ResetPasswordAsync(user)">Save</button>
                                    <button class="btn btn-sm btn-secondary" @onclick="CancelReset">Cancel</button>
                                </div>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="() => StartReset(user)">Set password</button>
                                @if (!isSelf)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="() => ToggleAdminAsync(user)">
                                        @(user.IsAdmin ? "Remove admin" : "Make admin")
                                    </button>
                                    @if (confirmDeleteId == user.Id)
                                    {
                                        <button class="btn btn-sm btn-danger" disabled="@busy" @onclick="() => DeleteAsync(user)">Confirm delete</button>
                                        <button class="btn btn-sm btn-secondary" @onclick="() => confirmDeleteId = null">Cancel</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-danger" disabled="@busy" @onclick="() => confirmDeleteId = user.Id">Delete</button>
                                    }
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private IReadOnlyList<ManagedUser>? users;
    private string currentUserId = "";
    private NewUserModel newUser = new();
    private string? message;
    private bool messageIsError;
    private bool busy;
    private string? confirmDeleteId;
    private string? resetUserId;
    private string resetPassword = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationState;
        currentUserId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        await LoadAsync();
    }

    private async Task LoadAsync() => users = await UserAdmin.ListAsync();

    private async Task CreateUserAsync()
    {
        await RunAsync(
            () => UserAdmin.CreateAsync(newUser.UserName, newUser.Password, newUser.IsAdmin),
            $"Added user '{newUser.UserName}'.");
        if (!messageIsError)
        {
            newUser = new();
        }
    }

    private Task ToggleAdminAsync(ManagedUser user) =>
        RunAsync(
            () => UserAdmin.SetAdminAsync(user.Id, !user.IsAdmin, currentUserId),
            user.IsAdmin ? $"'{user.UserName}' is no longer an admin." : $"'{user.UserName}' is now an admin.");

    private void StartReset(ManagedUser user)
    {
        resetUserId = user.Id;
        resetPassword = "";
    }

    private void CancelReset()
    {
        resetUserId = null;
        resetPassword = "";
    }

    private async Task ResetPasswordAsync(ManagedUser user)
    {
        await RunAsync(() => UserAdmin.ResetPasswordAsync(user.Id, resetPassword), $"Password updated for '{user.UserName}'.");
        if (!messageIsError)
        {
            CancelReset();
        }
    }

    private async Task DeleteAsync(ManagedUser user)
    {
        confirmDeleteId = null;
        await RunAsync(() => UserAdmin.DeleteAsync(user.Id, currentUserId), $"Deleted user '{user.UserName}'.");
    }

    private async Task RunAsync(Func<Task<UserAdminResult>> action, string successMessage)
    {
        busy = true;
        try
        {
            var result = await action();
            messageIsError = !result.Succeeded;
            message = result.Succeeded ? successMessage : result.Error;
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class NewUserModel
    {
        [Required]
        public string UserName { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";

        public bool IsAdmin { get; set; }
    }
}

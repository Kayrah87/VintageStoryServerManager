@page "/admin/users"
@attribute [Authorize(Roles = Roles.Admin)]

@using System.Security.Claims
@using VintageStoryServerManager.Web.Data

@inject UserAdministrationService UserAdmin
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Users</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Users</MudText>
<MudText Class="mb-4" Color="Color.Secondary">
    Viewers can see the dashboard and mods. Operators can also start and stop the server, use the console and manage players.
    Admins can do everything.
</MudText>

<MudPaper Class="pa-4 mb-6" Elevation="1">
    <MudText Typo="Typo.h6" GutterBottom="true">Add user</MudText>
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="newUserName" Label="Username" Variant="Variant.Outlined" Margin="Margin.Dense" autocomplete="off" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="newPassword" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense"
                          autocomplete="new-password" HelperText="At least 6 characters with upper and lower case, a digit and a symbol." />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudSelect T="string" @bind-Value="newRole" Label="Role" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var option in RoleOptions)
                {
                    <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="busy" OnClick="CreateUserAsync">Add</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="users" Loading="users is null" Hover="true" Dense="true" Elevation="1">
    <HeaderContent>
        <MudTh>Username</MudTh>
        <MudTh>Role</MudTh>
        <MudTh>Status</MudTh>
        <MudTh Style="text-align:right">Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        @{ var isSelf = context.Id == currentUserId; }
        <MudTd DataLabel="Username">@context.UserName @(isSelf ? "(you)" : "")</MudTd>
        <MudTd DataLabel="Role">
            @if (isSelf)
            {
                @RoleLabel(context.Role)
            }
            else
            {
                <MudSelect T="string" Value="@(context.Role ?? ViewerValue)" ValueChanged="@(role => SetRoleAsync(context, role))"
                           Dense="true" Margin="Margin.Dense" Disabled="busy" Style="max-width:12rem">
                    @foreach (var option in RoleOptions)
                    {
                        <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                    }
                </MudSelect>
            }
        </MudTd>
        <MudTd DataLabel="Status">
            @if (context.IsLockedOut)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning">Locked out</MudChip>
            }
            else
            {
                <MudChip T="string" Size="Size.Small">Active</MudChip>
            }
        </MudTd>
        <MudTd Style="text-align:right">
            @if (resetUserId == context.Id)
            {
                <div class="d-inline-flex gap-2 align-center">
                    <MudTextField @bind-Value="resetPassword" Placeholder="New password" InputType="InputType.Password" Margin="Margin.Dense"
                                  Variant="Variant.Outlined" autocomplete="new-password" />
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="() => ResetPasswordAsync(context)">Save</MudButton>
                    <MudButton Size="Size.Small" OnClick="CancelReset">Cancel</MudButton>
                </div>
            }
            else
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="busy" OnClick="() => StartReset(context)">Set password</MudButton>
                @if (!isSelf)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Disabled="busy"
                                   OnClick="() => DeleteAsync(context)" aria-label="Delete user" title="Delete user" />
                }
            }
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private const string ViewerValue = "";

    private static readonly (string Value, string Label)[] RoleOptions =
        [(ViewerValue, "Viewer"), (Roles.Operator, "Operator"), (Roles.Admin, "Admin")];

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private IReadOnlyList<ManagedUser>? users;
    private string currentUserId = "";
    private string newUserName = "";
    private string newPassword = "";
    private string newRole = ViewerValue;
    private bool busy;
    private string? resetUserId;
    private string resetPassword = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationState;
        currentUserId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        await LoadAsync();
    }

    private static string RoleLabel(string? role) => RoleOptions.First(o => o.Value == (role ?? ViewerValue)).Label;

    private static string? ToRole(string value) => value == ViewerValue ? null : value;

    private async Task LoadAsync() => users = await UserAdmin.ListAsync();

    private async Task CreateUserAsync()
    {
        var name = newUserName;
        if (await RunAsync(() => UserAdmin.CreateAsync(name, newPassword, ToRole(newRole)), $"Added user '{name}'."))
        {
            newUserName = newPassword = "";
            newRole = ViewerValue;
        }
    }

    private Task SetRoleAsync(ManagedUser user, string role) =>
        RunAsync(() => UserAdmin.SetRoleAsync(user.Id, ToRole(role), currentUserId), $"'{user.UserName}' is now {RoleLabel(ToRole(role)).ToLowerInvariant()}.");

    private void StartReset(ManagedUser user)
    {
        resetUserId = user.Id;
        resetPassword = "";
    }

    private void CancelReset()
    {
        resetUserId = null;
        resetPassword = "";
    }

    private async Task ResetPasswordAsync(ManagedUser user)
    {
        if (await RunAsync(() => UserAdmin.ResetPasswordAsync(user.Id, resetPassword), $"Password updated for '{user.UserName}'."))
        {
            CancelReset();
        }
    }

    private async Task DeleteAsync(ManagedUser user)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Delete user", $"Delete '{user.UserName}'? This can't be undone.", yesText: "Delete", cancelText: "Cancel");
        if (confirmed == true)
        {
            await RunAsync(() => UserAdmin.DeleteAsync(user.Id, currentUserId), $"Deleted user '{user.UserName}'.");
        }
    }

    private async Task<bool> RunAsync(Func<Task<UserAdminResult>> action, string successMessage)
    {
        busy = true;
        try
        {
            var result = await action();
            Snackbar.Add(result.Succeeded ? successMessage : result.Error!, result.Succeeded ? Severity.Success : Severity.Error);
            await LoadAsync();
            return result.Succeeded;
        }
        finally
        {
            busy = false;
        }
    }
}

{
  "DataPaths": {
    "Root": "/data",
    "GameInstallDirectory": "/opt/vintagestory"
  },
  "Server": {
    "AutoStart": true,
    "RestartOnCrash": true,
    "StopTimeoutSeconds": 90
  },
  "Backups": {
    "KeepAutomatic": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
